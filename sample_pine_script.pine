//@version=5
indicator("EA Signal Assistant - Portfolio Sample", overlay=true)

// ATR-based signal system
atrLength = input.int(14, "ATR Length")
atr = ta.atr(atrLength)

// Trend detection
emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
trendUp = emaFast > emaSlow
trendDown = emaFast < emaSlow

// Signal conditions
buySignal = ta.crossover(emaFast, emaSlow) and trendUp
sellSignal = ta.crossunder(emaFast, emaSlow) and trendDown

// Plot
plotshape(buySignal, "Buy", shape.triangleup, location.belowbar, color.green)
plotshape(sellSignal, "Sell", shape.triangledown, location.abovebar, color.red)
plot(emaFast, "Fast EMA", color.blue)
plot(emaSlow, "Slow EMA", color.orange)

// Alerts
alertcondition(buySignal, "Buy Alert")
alertcondition(sellSignal, "Sell Alert")
